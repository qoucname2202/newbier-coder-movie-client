# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
*.md

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# config files with sensitive information
next.config.js

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.local
.env.development
.env.test
.env.production
!.env.example
.md
# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# config files with sensitive keys
next.config.js

# impeccable & AI local tools (personal workflow)
/impeccable/
.impeccable/
.agent/
.agents/
.gemini/
.claude/
.cursor/
.codex/
PRODUCT.md
DESIGN.md
.dev/
AGENTS.md
CLAUDE.md
public/data/dashboard-snapshot.json

# local dev logs
dev-log.txt
*.log

# local ESLint runtime (the TypeScript parser runs with its own TypeScript)
/.eslint-runtime/

# local ESLint report (generated when the lint is analyzed rule by rule)
.eslint-report.json
