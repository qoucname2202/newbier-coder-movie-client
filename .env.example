# API URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Authentication
NEXT_PUBLIC_JWT_EXPIRATION=3600

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Optional: Analytics and third-party services
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=

# Movie & Homepage Settings
NEXT_PUBLIC_USE_MOCK_DATA=true
NEXT_PUBLIC_HERO_DESC_LIMIT=220
NEXT_PUBLIC_HERO_AUTOPLAY_INTERVAL=6000

# Route Settings (optional comma-separated path prefixes to suppress ads)
# NEXT_PUBLIC_AD_EXCLUDED_PATHS=/auth/,/admin/,/payment/
